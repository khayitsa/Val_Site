+{% extends "base.html" %}
+{% block title %}{{ _("Something went wrong") }} | Verayah{% endblock %}
+{% block content %}
+<section class="page-section"><div class="wrap" style="text-align:center;padding:5rem 0;">
+  <span class="eyebrow">500</span>
+  <h1>{{ _("Something went wrong on our side") }}</h1>
+  <p class="muted">{{ _("Please try again in a moment. If it keeps happening, contact us and we will sort it out.") }}</p>
+  <p style="margin-top:1.5rem;">
+    <a href="{{ url_for('home') }}" class="btn-fill">{{ _("Back to home") }}</a>
+  </p>
+</div></section>
+{% endblock %}
