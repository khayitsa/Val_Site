# Copy this file to .env and fill in real values. Never commit .env itself.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to "production" once the site is served over HTTPS, so login cookies
# are marked Secure. Leave blank for local development over http://.
FLASK_ENV=

# Optional: point at a different database (Postgres, etc). Defaults to a
# local SQLite file at instance/verayah.db if left unset.
DATABASE_URL=

# --- Shop & business details (all optional - blank shows as "not decided" on the site) ---
# Courier fee within Panama in USD, e.g. 5.00. Blank = "confirmed with your payment details".
DELIVERY_FEE=
BUSINESS_OPERATOR=Valentina Garcia
BUSINESS_EMAIL=verayahpty@gmail.com
BUSINESS_PHONE=+507 6904-0901
# The shop's public address, e.g. https://yourname.pythonanywhere.com - used for the
# links in order emails (so they always point at your real site). Leave blank until mail is on.
PUBLIC_BASE_URL=
# Most pieces allowed in one website order (stock is held from the moment an order is
# placed, before payment). Blank = 6. Bigger orders: customers contact you.
MAX_UNITS_PER_ORDER=
# Hours an unpaid website order holds its pieces before it is cancelled automatically and
# the pieces go back on sale. Blank = 4. 0 = never cancel automatically (not recommended).
UNPAID_HOLD_HOURS=
# Digits only, used for the WhatsApp link on the order confirmation, e.g. 50769040901
WHATSAPP_NUMBER=50769040901
BUSINESS_ADDRESS=Panama City, Panama
RETURNS_ADDRESS=
# Shown to the customer on the order confirmation page
YAPPY_NUMBER=
BANK_DETAILS=
# Footer social links - only shown when filled in. INSTAGRAM_URL is a placeholder until
# the real profile link is known; it is also the "Instagram DM" link for payment proof.
INSTAGRAM_URL=https://instagram.com
PINTEREST_URL=
TIKTOK_URL=
# Set to 0 once the final legal wording is in, to hide the "draft wording" banner
LEGAL_DRAFT=1

# --- Email alerts (optional - leave blank to send no emails) ---
# With these filled in, the shop owner gets an email for every new order and
# contact-form message, and the customer gets an order confirmation.
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USER=your gmail address,
# MAIL_PASSWORD = a 16-character "App password" (Google Account > Security >
# 2-Step Verification > App passwords) - NOT your normal Gmail password.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# Shown as the sender. Leave blank to use MAIL_USER.
MAIL_FROM=
# Where order and message alerts go. Leave blank to use BUSINESS_EMAIL.
NOTIFY_EMAIL=

# --- Language (English / Spanish) ---
# What a first-time visitor sees: "auto" follows their browser's language,
# or force "en" / "es". Visitors can always switch with the EN | ES links,
# and their choice is remembered.
DEFAULT_LANG=auto
# Language of the alert emails sent to the shop owner (new order / new message).
OWNER_LANG=en
