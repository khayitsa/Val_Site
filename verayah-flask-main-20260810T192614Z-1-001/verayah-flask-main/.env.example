# Copy this file to .env and fill in real values. Never commit .env itself.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to "production" once the site is served over HTTPS, so login cookies
# are marked Secure. Leave blank for local development over http://.
FLASK_ENV=

# Optional: point at a different database (Postgres, etc). Defaults to a
# local SQLite file at instance/verayah.db if left unset.
DATABASE_URL=

# --- Shop & business details (all optional - blank shows as "not decided" on the site) ---
# Courier fee within Panama in USD, e.g. 5.00. Blank = "confirmed with your payment details".
DELIVERY_FEE=
BUSINESS_OPERATOR=Valentina Garcia
BUSINESS_EMAIL=
BUSINESS_PHONE=+507 6904-0901
# Digits only, used for the WhatsApp link on the order confirmation, e.g. 50769040901
WHATSAPP_NUMBER=
BUSINESS_ADDRESS=Panama City, Panama
RETURNS_ADDRESS=
# Shown to the customer on the order confirmation page
YAPPY_NUMBER=
BANK_DETAILS=
# Footer social links - only shown when filled in
INSTAGRAM_URL=
PINTEREST_URL=
TIKTOK_URL=
# Set to 0 once the final legal wording is in, to hide the "draft wording" banner
LEGAL_DRAFT=1
